#########################################################################
### FHIaims settings for generating MAD-1.5
#########################################################################


#########################
### Physical settings ###
#########################
override_warning_libxc          .true.
xc                              libxc MGGA_X_R2SCAN+MGGA_C_R2SCAN
spin                            none
charge                          0.
relativistic                    atomic_zora scalar
sc_iter_limit                   200
sc_init_iter                    99
basis_threshold                 1d-5
override_illconditioning        .true.

## Comment out for non-periodic systems:
k_grid_density                  8
override_kgrid_checks           .true.

## Dipole correction - turn on only for "mc2d" and "mc3d_surface" subsets
# use_dipole_correction           .true.



############################
### Convergence settings ###
############################
adjust_scf                      always 2
adjust_scf_param                lowgap occupation_width 0.05
adjust_scf_param                largegap occupation_width 0.05

sc_accuracy_etot                1e-6
sc_accuracy_forces              1e-4
sc_accuracy_rho                 1e-5


#######################
### Output settings ###
#######################

# (energy automatically printed in aims.out)            # energy
compute_forces                  .true.                  # forces

## Comment out for non-periodic systems:
compute_analytical_stress       .true.                  # stress
